{
  "family": "my-crud-td",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "my-crud",
      "image": "903685415911.dkr.ecr.ap-southeast-2.amazonaws.com/my-crud",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/my-crud",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "SPRING_DATASOURCE_URL"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "SPRING_DATASOURCE_USERNAME"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "SPRING_DATASOURCE_PASSWORD"
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::903685415911:role/ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::903685415911:role/ecs-task-s3-role"
}